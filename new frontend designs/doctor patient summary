<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Patient View - Doctor Console</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600&amp;family=Quicksand:wght@600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary": "#556158",
                        "primary-fixed-dim": "#a1d494",
                        "surface-container-high": "#eae8e7",
                        "on-tertiary-fixed": "#1b1d0e",
                        "outline-variant": "#c2c9bb",
                        "on-tertiary-fixed-variant": "#474836",
                        "on-secondary-fixed-variant": "#3e4a41",
                        "inverse-surface": "#303030",
                        "tertiary-container": "#50513f",
                        "background": "#fbf9f8",
                        "on-secondary": "#ffffff",
                        "error": "#ba1a1a",
                        "secondary-container": "#d9e6da",
                        "surface": "#fbf9f8",
                        "primary": "#154212",
                        "inverse-on-surface": "#f2f0f0",
                        "on-error": "#ffffff",
                        "on-tertiary-container": "#c3c4ac",
                        "on-primary-fixed-variant": "#23501e",
                        "tertiary-fixed": "#e4e4cc",
                        "error-container": "#ffdad6",
                        "on-tertiary": "#ffffff",
                        "on-primary": "#ffffff",
                        "on-primary-fixed": "#002201",
                        "surface-container-highest": "#e4e2e2",
                        "on-secondary-fixed": "#131e17",
                        "primary-container": "#2d5a27",
                        "on-surface-variant": "#42493e",
                        "surface-container": "#efeded",
                        "tertiary-fixed-dim": "#c8c8b0",
                        "surface-bright": "#fbf9f8",
                        "surface-variant": "#e4e2e2",
                        "on-background": "#1b1c1c",
                        "on-secondary-container": "#5b675e",
                        "on-surface": "#1b1c1c",
                        "surface-tint": "#3b6934",
                        "tertiary": "#393a29",
                        "primary-fixed": "#bcf0ae",
                        "secondary-fixed": "#d9e6da",
                        "on-primary-container": "#9dd090",
                        "secondary-fixed-dim": "#bdcabe",
                        "surface-container-lowest": "#ffffff",
                        "on-error-container": "#93000a",
                        "surface-dim": "#dbd9d9",
                        "surface-container-low": "#f5f3f3",
                        "outline": "#72796e",
                        "inverse-primary": "#a1d494"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "unit-3": "1.5rem",
                        "container-margin": "24px",
                        "unit-2": "1rem",
                        "gutter": "16px",
                        "unit-1": "0.5rem",
                        "unit-6": "3rem",
                        "unit-4": "2rem",
                        "base": "8px"
                    },
                    "fontFamily": {
                        "body-md": [
                            "Public Sans"
                        ],
                        "body-lg": [
                            "Public Sans"
                        ],
                        "headline-md": [
                            "Quicksand"
                        ],
                        "display-lg": [
                            "Quicksand"
                        ],
                        "display-lg-mobile": [
                            "Quicksand"
                        ],
                        "label-sm": [
                            "Public Sans"
                        ]
                    },
                    "fontSize": {
                        "body-md": [
                            "16px",
                            {
                                "lineHeight": "24px",
                                "fontWeight": "400"
                            }
                        ],
                        "body-lg": [
                            "18px",
                            {
                                "lineHeight": "28px",
                                "fontWeight": "400"
                            }
                        ],
                        "headline-md": [
                            "24px",
                            {
                                "lineHeight": "32px",
                                "fontWeight": "600"
                            }
                        ],
                        "display-lg": [
                            "40px",
                            {
                                "lineHeight": "48px",
                                "letterSpacing": "-0.02em",
                                "fontWeight": "700"
                            }
                        ],
                        "display-lg-mobile": [
                            "32px",
                            {
                                "lineHeight": "40px",
                                "fontWeight": "700"
                            }
                        ],
                        "label-sm": [
                            "14px",
                            {
                                "lineHeight": "20px",
                                "letterSpacing": "0.01em",
                                "fontWeight": "600"
                            }
                        ]
                    }
                },
            },
        }
    </script>
    <style>
        /* Neomorphism Lite Shadows */
        .neo-card {
            box-shadow: -4px -4px 16px rgba(255, 255, 255, 0.8), 4px 4px 16px rgba(85, 97, 88, 0.1);
        }

        .neo-pressed {
            box-shadow: inset -4px -4px 16px rgba(255, 255, 255, 0.8), inset 4px 4px 16px rgba(85, 97, 88, 0.1);
        }
    </style>
</head>

<body class="bg-background text-on-background font-body-md h-screen flex flex-col overflow-hidden">
    <!-- TopAppBar -->
    <header
        class="flex items-center justify-between px-container-margin py-unit-2 w-full top-0 bg-background dark:bg-background shadow-[4px_4px_16px_rgba(85,97,88,0.1),-4px_-4px_16px_rgba(255,255,255,0.8)] z-50">
        <div class="flex items-center gap-unit-2">
            <span class="material-symbols-outlined text-primary dark:text-primary-fixed-dim"
                style="font-variation-settings: 'FILL' 1;">monitor_heart</span>
            <h1 class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">Doctor
                Console</h1>
        </div>
        <div
            class="flex items-center gap-unit-2 text-on-surface-variant dark:text-on-surface-variant font-label-sm text-label-sm">
            <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center overflow-hidden">
                <img class="object-cover w-full h-full"
                    data-alt="Professional headshot of a doctor with a warm, reassuring smile in a bright, modern clinical setting with soft natural light."
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDwZbHsEUns0W5zJWUt5ZFIvPztdyDyyzsTSMGm5aYP0tHS2ZYlk4Iy_ZpSHU6vtAQr68g4CvtB9Cm4u2782iLJACKUzR1BCUQ0ltos8JhjFve-pr6KquoiTPmEd5XWRRbaKErgBcmNij_MZoM3DD8_zdQ_HVsgMuyKchK9xIOrWDsFfUZoOlNg_DnjDBpkkax9iyPTBoHyU4CjnHRbuCGy58s3k2xN_FdM6FMaJEm35IrlzRlNMddGMQ" />
            </div>
            <span class="hidden md:inline">Doctor Profile</span>
        </div>
    </header>
    <div class="flex flex-1 overflow-hidden">
        <!-- NavigationDrawer (Desktop) -->
        <nav
            class="hidden md:flex fixed left-0 top-0 h-full z-40 flex-col p-unit-3 w-72 rounded-r-lg bg-surface dark:bg-surface shadow-[8px_0_24px_rgba(85,97,88,0.08)] pt-24">
            <div class="mb-unit-6">
                <h2 class="font-display-lg-mobile text-display-lg-mobile text-primary">MediKiosk Pro</h2>
            </div>
            <ul class="flex flex-col gap-unit-1">
                <li>
                    <a class="flex items-center gap-unit-2 text-on-surface-variant px-unit-2 py-unit-1 hover:bg-secondary-container dark:hover:bg-secondary-container/30 transition-all rounded-DEFAULT"
                        href="#">
                        <span class="material-symbols-outlined">group</span>
                        <span class="font-body-lg text-body-lg">Patient List</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-unit-2 bg-primary-container text-on-primary-container rounded-DEFAULT px-unit-2 py-unit-1 shadow-inner hover:bg-secondary-container dark:hover:bg-secondary-container/30 transition-all"
                        href="#">
                        <span class="material-symbols-outlined">medical_services</span>
                        <span class="font-body-lg text-body-lg">Active Consultations</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-unit-2 text-on-surface-variant px-unit-2 py-unit-1 hover:bg-secondary-container dark:hover:bg-secondary-container/30 transition-all rounded-DEFAULT"
                        href="#">
                        <span class="material-symbols-outlined">history</span>
                        <span class="font-body-lg text-body-lg">Medical History</span>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto p-container-margin md:ml-72 pb-24 md:pb-container-margin">
            <div class="max-w-5xl mx-auto space-y-unit-4">
                <!-- Patient Header -->
                <div class="flex flex-col md:flex-row gap-unit-3 items-start md:items-center justify-between">
                    <div>
                        <div class="flex items-center gap-unit-2 mb-1">
                            <span
                                class="px-3 py-1 bg-error-container text-on-error-container rounded-full font-label-sm text-label-sm">Urgent</span>
                            <span class="text-on-surface-variant font-label-sm text-label-sm">ID: MK-29384</span>
                        </div>
                        <h2 class="font-display-lg-mobile text-display-lg-mobile text-on-background">Rahul Sharma</h2>
                        <p class="text-on-surface-variant font-body-lg text-body-lg mt-1">45 Y/O • Male</p>
                    </div>
                    <button
                        class="bg-primary text-on-primary px-unit-4 py-unit-2 rounded-full font-label-sm text-label-sm hover:opacity-90 transition-opacity flex items-center gap-2 neo-card active:scale-95 duration-200">
                        <span class="material-symbols-outlined">video_camera_front</span>
                        Start Consultation
                    </button>
                </div>
                <!-- Bento Grid -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-unit-3">
                    <!-- Chief Complaint & Vitals (Col 1-8) -->
                    <div class="md:col-span-8 flex flex-col gap-unit-3">
                        <!-- Chief Complaint -->
                        <div class="bg-surface rounded-xl p-unit-3 neo-card">
                            <div class="flex items-center gap-2 mb-unit-2 text-primary">
                                <span class="material-symbols-outlined">report</span>
                                <h3 class="font-headline-md text-headline-md">Chief Complaint</h3>
                            </div>
                            <p class="font-body-lg text-body-lg text-error font-semibold">Chest Pain</p>
                            <p class="text-on-surface-variant mt-2">Patient reports radiating pain to the left arm,
                                onset 2 hours ago. Accompanied by mild diaphoresis.</p>
                        </div>
                        <!-- Vitals Overview -->
                        <div class="bg-surface rounded-xl p-unit-3 neo-card">
                            <div class="flex items-center gap-2 mb-unit-3 text-primary">
                                <span class="material-symbols-outlined">vital_signs</span>
                                <h3 class="font-headline-md text-headline-md">Vitals Overview</h3>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-unit-2">
                                <div
                                    class="neo-pressed rounded-lg p-unit-2 flex flex-col items-center justify-center bg-surface-container-low text-center">
                                    <span class="text-on-surface-variant font-label-sm text-label-sm mb-1">Blood
                                        Pressure</span>
                                    <span class="font-headline-md text-headline-md text-error">145/90</span>
                                    <span class="text-on-surface-variant text-xs">mmHg</span>
                                </div>
                                <div
                                    class="neo-pressed rounded-lg p-unit-2 flex flex-col items-center justify-center bg-surface-container-low text-center">
                                    <span class="text-on-surface-variant font-label-sm text-label-sm mb-1">Heart
                                        Rate</span>
                                    <span class="font-headline-md text-headline-md text-primary">98</span>
                                    <span class="text-on-surface-variant text-xs">bpm</span>
                                </div>
                                <div
                                    class="neo-pressed rounded-lg p-unit-2 flex flex-col items-center justify-center bg-surface-container-low text-center">
                                    <span class="text-on-surface-variant font-label-sm text-label-sm mb-1">SpO2</span>
                                    <span class="font-headline-md text-headline-md text-primary">96%</span>
                                    <span class="text-on-surface-variant text-xs">room air</span>
                                </div>
                                <div
                                    class="neo-pressed rounded-lg p-unit-2 flex flex-col items-center justify-center bg-surface-container-low text-center">
                                    <span class="text-on-surface-variant font-label-sm text-label-sm mb-1">Temp</span>
                                    <span class="font-headline-md text-headline-md text-primary">98.6°F</span>
                                    <span class="text-on-surface-variant text-xs">oral</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Clinical Questionnaire (Col 9-12) -->
                    <div class="md:col-span-4 bg-surface rounded-xl p-unit-3 neo-card flex flex-col">
                        <div class="flex items-center gap-2 mb-unit-3 text-primary">
                            <span class="material-symbols-outlined">assignment</span>
                            <h3 class="font-headline-md text-headline-md">Questionnaire</h3>
                        </div>
                        <div class="flex-1 flex flex-col gap-unit-2">
                            <div class="flex justify-between items-center pb-2 border-b border-outline-variant/30">
                                <span class="text-on-surface-variant">Pain Scale</span>
                                <span
                                    class="font-semibold px-2 py-1 bg-surface-container-high rounded-DEFAULT text-primary">4
                                    / 10</span>
                            </div>
                            <div class="flex justify-between items-center pb-2 border-b border-outline-variant/30">
                                <span class="text-on-surface-variant">Shortness of Breath</span>
                                <span class="font-semibold text-error">Yes</span>
                            </div>
                            <div class="flex justify-between items-center pb-2 border-b border-outline-variant/30">
                                <span class="text-on-surface-variant">Nausea</span>
                                <span class="font-semibold text-primary">No</span>
                            </div>
                            <div class="flex justify-between items-center pb-2 border-b border-outline-variant/30">
                                <span class="text-on-surface-variant">Dizziness</span>
                                <span class="font-semibold text-primary">No</span>
                            </div>
                        </div>
                    </div>
                    <!-- AYUSH Notes & Medical Records (Full width split) -->
                    <div class="md:col-span-12 grid grid-cols-1 md:grid-cols-2 gap-unit-3">
                        <!-- AYUSH Notes -->
                        <div class="bg-surface rounded-xl p-unit-3 neo-card">
                            <div class="flex items-center gap-2 mb-unit-3 text-primary">
                                <span class="material-symbols-outlined">eco</span>
                                <h3 class="font-headline-md text-headline-md">AYUSH Notes</h3>
                            </div>
                            <div
                                class="p-unit-2 bg-secondary-container/20 rounded-lg border border-secondary-container">
                                <p class="text-on-surface-variant mb-2"><strong class="text-primary">Prakriti:</strong>
                                    Vata-Pitta dominant.</p>
                                <p class="text-on-surface-variant mb-2"><strong class="text-primary">Recent
                                        Lifestyle:</strong> Reports high stress at work, irregular meal timings, and
                                    poor sleep quality over the past week.</p>
                                <p class="text-on-surface-variant"><strong class="text-primary">Holistic
                                        Indicators:</strong> Digestion (Agni) is irregular. Energy levels reported as
                                    low.</p>
                            </div>
                        </div>
                        <!-- Scanned Records Preview -->
                        <div class="bg-surface rounded-xl p-unit-3 neo-card flex flex-col">
                            <div class="flex items-center justify-between mb-unit-3">
                                <div class="flex items-center gap-2 text-primary">
                                    <span class="material-symbols-outlined">description</span>
                                    <h3 class="font-headline-md text-headline-md">Scanned Records</h3>
                                </div>
                                <button class="text-primary text-sm hover:underline font-label-sm">View All</button>
                            </div>
                            <div class="grid grid-cols-2 gap-unit-2 flex-1">
                                <div
                                    class="relative rounded-lg overflow-hidden h-24 border border-outline-variant/50 group cursor-pointer">
                                    <div
                                        class="absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors z-10">
                                    </div>
                                    <img class="w-full h-full object-cover"
                                        data-alt="A blurred, stylized preview of an ECG/EKG strip report with soft green lighting, suggesting medical data on a soft white background."
                                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAjjmBnB1duq-v_7zAERQ2r7HmnfGNbwxIowQ72OcZfX1NVNJIb1SMDMwVr6YYOXPc1I0hnAzoZ10U0B0cSzQgsKx5LkaVl-HBN0qCGxi5Tphtvg9y8nlp9bdeun3f41Obp_8BQtzPOCTDFXbi01xfdFccM3GAdaa2ESd68rgcZOEMp4L0uVZqjST1rzsk5lmdSloL2xmV_NT6nffXx97ynD7fYk34l9oAu7817qGuPHEkXStImsb74aQ" />
                                    <div
                                        class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-black/60 to-transparent p-1 z-20 text-white text-xs">
                                        Recent ECG</div>
                                </div>
                                <div
                                    class="relative rounded-lg overflow-hidden h-24 border border-outline-variant/50 group cursor-pointer flex items-center justify-center bg-surface-container-low hover:bg-surface-container-high transition-colors text-primary">
                                    <div class="text-center">
                                        <span class="material-symbols-outlined mb-1">upload_file</span>
                                        <p class="text-xs">Upload New</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <!-- BottomNavBar (Mobile) -->
    <nav
        class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center px-gutter py-unit-1 md:hidden bg-surface-container-low dark:bg-surface-container-low shadow-[0_-4px_24px_rgba(85,97,88,0.1)] rounded-t-lg">
        <a class="flex flex-col items-center justify-center text-on-surface-variant px-unit-3 py-unit-1 hover:opacity-80 transition-opacity active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined">group</span>
            <span class="font-label-sm text-label-sm">Patients</span>
        </a>
        <a class="flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl px-unit-3 py-unit-1 hover:opacity-80 transition-opacity active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined">medical_services</span>
            <span class="font-label-sm text-label-sm">Active</span>
        </a>
        <a class="flex flex-col items-center justify-center text-on-surface-variant px-unit-3 py-unit-1 hover:opacity-80 transition-opacity active:scale-90 duration-200"
            href="#">
            <span class="material-symbols-outlined">history</span>
            <span class="font-label-sm text-label-sm">History</span>
        </a>
    </nav>
</body>

</html>