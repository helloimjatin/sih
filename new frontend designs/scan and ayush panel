<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport" />
    <title>Medical Scans &amp; Wellness</title>
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <!-- Tailwind Config -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "inverse-primary": "#a1d494",
                        "on-tertiary": "#ffffff",
                        "tertiary": "#393a29",
                        "on-secondary-fixed-variant": "#3e4a41",
                        "secondary-container": "#d9e6da",
                        "primary-fixed-dim": "#a1d494",
                        "on-tertiary-container": "#c3c4ac",
                        "surface-container-highest": "#e4e2e2",
                        "tertiary-fixed": "#e4e4cc",
                        "error-container": "#ffdad6",
                        "on-surface-variant": "#42493e",
                        "surface": "#fbf9f8",
                        "secondary-fixed-dim": "#bdcabe",
                        "error": "#ba1a1a",
                        "surface-container": "#efeded",
                        "on-secondary-container": "#5b675e",
                        "primary-container": "#2d5a27",
                        "surface-bright": "#fbf9f8",
                        "primary-fixed": "#bcf0ae",
                        "on-primary-fixed-variant": "#23501e",
                        "inverse-on-surface": "#f2f0f0",
                        "outline-variant": "#c2c9bb",
                        "surface-container-low": "#f5f3f3",
                        "on-surface": "#1b1c1c",
                        "surface-tint": "#3b6934",
                        "inverse-surface": "#303030",
                        "secondary": "#556158",
                        "on-primary-container": "#9dd090",
                        "on-tertiary-fixed-variant": "#474836",
                        "surface-container-lowest": "#ffffff",
                        "secondary-fixed": "#d9e6da",
                        "on-secondary": "#ffffff",
                        "on-error": "#ffffff",
                        "surface-variant": "#e4e2e2",
                        "on-background": "#1b1c1c",
                        "on-primary": "#ffffff",
                        "outline": "#72796e",
                        "primary": "#154212",
                        "background": "#fbf9f8",
                        "surface-dim": "#dbd9d9",
                        "on-error-container": "#93000a",
                        "on-tertiary-fixed": "#1b1d0e",
                        "tertiary-fixed-dim": "#c8c8b0",
                        "on-secondary-fixed": "#131e17",
                        "tertiary-container": "#50513f",
                        "on-primary-fixed": "#002201",
                        "surface-container-high": "#eae8e7"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-margin": "24px",
                        "unit-1": "0.5rem",
                        "gutter": "16px",
                        "unit-6": "3rem",
                        "unit-4": "2rem",
                        "base": "8px",
                        "unit-2": "1rem",
                        "unit-3": "1.5rem"
                    },
                    "fontFamily": {
                        "label-sm": ["Public Sans", "sans-serif"],
                        "body-md": ["Public Sans", "sans-serif"],
                        "display-lg": ["Quicksand", "sans-serif"],
                        "body-lg": ["Public Sans", "sans-serif"],
                        "headline-md": ["Quicksand", "sans-serif"],
                        "display-lg-mobile": ["Quicksand", "sans-serif"]
                    },
                    "fontSize": {
                        "label-sm": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "display-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "40px", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600&amp;family=Quicksand:wght@600;700&amp;display=swap"
        rel="stylesheet" />
    <!-- Material Symbols -->
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <style>
        /* Neomorphism Lite Shadows */
        .neo-card {
            box-shadow: 8px 8px 24px rgba(45, 90, 39, 0.05), -8px -8px 24px #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.8);
        }

        .neo-input {
            box-shadow: inset 4px 4px 12px rgba(45, 90, 39, 0.05), inset -4px -4px 12px #ffffff;
        }

        .neo-button-primary {
            box-shadow: 6px 6px 16px rgba(45, 90, 39, 0.2), -4px -4px 12px rgba(255, 255, 255, 0.8);
            transition: all 0.2s ease;
        }

        .neo-button-primary:active {
            box-shadow: inset 4px 4px 8px rgba(0, 0, 0, 0.1), inset -4px -4px 8px rgba(255, 255, 255, 0.2);
            transform: translateY(2px);
        }

        .neo-button-secondary {
            box-shadow: 4px 4px 12px rgba(45, 90, 39, 0.05), -4px -4px 12px #ffffff;
            transition: all 0.2s ease;
        }

        .neo-button-secondary:active {
            box-shadow: inset 4px 4px 8px rgba(45, 90, 39, 0.05), inset -4px -4px 8px #ffffff;
            transform: translateY(2px);
        }

        /* Progress Bar Animation */
        @keyframes fillProgress {
            from {
                width: 60%;
            }

            to {
                width: 80%;
            }
        }

        .progress-fill {
            animation: fillProgress 1s ease-out forwards;
        }
    </style>
    <style>
        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>

<body
    class="bg-background text-on-background antialiased min-h-screen flex flex-col selection:bg-primary-container selection:text-on-primary-container">
    <!-- Top Navigation (Shell suppressed for linear task flow, using simplified top bar) -->
    <header
        class="w-full px-container-margin py-unit-4 flex items-center justify-between fixed top-0 z-40 bg-background/90 backdrop-blur-md">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-3xl"
                style="font-variation-settings: 'FILL' 1;">healing</span>
            <span class="font-headline-md text-headline-md font-bold text-primary tracking-tight">MediKiosk</span>
        </div>
        <button aria-label="Help"
            class="w-12 h-12 flex items-center justify-center rounded-full neo-button-secondary text-primary">
            <span class="material-symbols-outlined">help</span>
        </button>
    </header>
    <!-- Main Canvas -->
    <main class="flex-grow pt-28 pb-32 px-container-margin max-w-3xl mx-auto w-full flex flex-col gap-unit-6">
        <!-- Header & Progress -->
        <div class="flex flex-col gap-unit-2 text-center">
            <h1
                class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-primary">
                Medical Scans &amp; Wellness</h1>
            <p class="font-body-lg text-body-lg text-secondary">Step 4 of 5</p>
            <!-- Soft Progress Bar -->
            <div class="w-full h-4 bg-surface-container-highest rounded-full mt-2 overflow-hidden neo-input">
                <div
                    class="h-full bg-gradient-to-r from-primary-fixed to-primary-container rounded-full progress-fill w-4/5 shadow-[0_0_10px_rgba(45,90,39,0.3)]">
                </div>
            </div>
        </div>
        <!-- Document Scanner Section -->
        <section class="neo-card bg-surface p-unit-4 rounded-xl flex flex-col gap-unit-4">
            <div class="flex items-center gap-3 mb-2">
                <div
                    class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container">
                    <span class="material-symbols-outlined">document_scanner</span>
                </div>
                <h2 class="font-headline-md text-headline-md text-primary">Scan Reports &amp; Prescriptions</h2>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">
                We'll automatically extract key details from your documents.
            </p>
            <button
                class="w-full h-40 border-2 border-dashed border-outline-variant rounded-lg flex flex-col items-center justify-center gap-3 bg-surface-container-lowest hover:bg-surface-container-low transition-colors group cursor-pointer focus:outline-none focus:ring-4 focus:ring-primary-fixed">
                <span
                    class="material-symbols-outlined text-4xl text-secondary group-hover:text-primary transition-colors"
                    style="font-variation-settings: 'FILL' 0;">photo_camera</span>
                <span class="font-label-sm text-label-sm text-secondary group-hover:text-primary transition-colors">Tap
                    to Upload or Scan</span>
            </button>
        </section>
        <!-- AYUSH & Traditional Medicine Section -->
        <section class="neo-card bg-surface p-unit-4 rounded-xl flex flex-col gap-unit-4">
            <div class="flex items-center gap-3 mb-2">
                <div
                    class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
                    <span class="material-symbols-outlined">spa</span>
                </div>
                <h2 class="font-headline-md text-headline-md text-primary">Traditional Wellness (AYUSH)</h2>
            </div>
            <label class="font-body-md text-body-md text-on-surface-variant" for="traditional-meds">
                Are you currently using any traditional treatments, homeopathy, or supplements?
            </label>
            <textarea
                class="neo-input bg-surface-container-lowest w-full rounded-lg p-4 font-body-md text-body-md text-on-surface border-none focus:ring-2 focus:ring-primary-container outline-none resize-none placeholder-outline"
                id="traditional-meds" placeholder="e.g., Ayurvedic supplements, traditional home remedies, etc."
                rows="4"></textarea>
        </section>
    </main>
    <!-- Bottom Navigation Bar (Linear Flow - Back/Next instead of global nav) -->
    <div
        class="fixed bottom-0 left-0 w-full bg-surface-container-low/90 backdrop-blur-md px-container-margin py-4 pb-safe border-t border-surface-container-highest z-50 shadow-[0_-4px_24px_rgba(0,0,0,0.05)]">
        <div class="max-w-3xl mx-auto flex justify-between items-center gap-4">
            <button
                class="neo-button-secondary h-16 px-8 rounded-full flex items-center justify-center gap-2 bg-surface text-primary font-label-sm text-label-sm focus:outline-none focus:ring-4 focus:ring-primary-fixed">
                <span class="material-symbols-outlined">arrow_back</span>
                Back
            </button>
            <button
                class="neo-button-primary h-16 px-10 rounded-full flex items-center justify-center gap-2 bg-primary text-on-primary font-label-sm text-label-sm flex-grow md:flex-grow-0 focus:outline-none focus:ring-4 focus:ring-primary-fixed">
                Next Step
                <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </div>
    </div>
</body>

</html>