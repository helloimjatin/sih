<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MediKiosk - Clinical Questionnaire</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600&amp;family=Quicksand:wght@600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "tertiary-fixed-dim": "#c8c8b0",
                        "primary-fixed-dim": "#a1d494",
                        "inverse-primary": "#a1d494",
                        "background": "#fbf9f8",
                        "secondary": "#556158",
                        "on-tertiary-fixed": "#1b1d0e",
                        "on-error-container": "#93000a",
                        "on-background": "#1b1c1c",
                        "tertiary-container": "#50513f",
                        "on-primary": "#ffffff",
                        "surface-variant": "#e4e2e2",
                        "on-secondary-fixed": "#131e17",
                        "on-primary-fixed": "#002201",
                        "on-surface": "#1b1c1c",
                        "surface-bright": "#fbf9f8",
                        "primary-fixed": "#bcf0ae",
                        "on-error": "#ffffff",
                        "surface": "#fbf9f8",
                        "primary": "#154212",
                        "error": "#ba1a1a",
                        "on-tertiary-container": "#c3c4ac",
                        "primary-container": "#2d5a27",
                        "outline-variant": "#c2c9bb",
                        "on-secondary-fixed-variant": "#3e4a41",
                        "tertiary": "#393a29",
                        "inverse-surface": "#303030",
                        "outline": "#72796e",
                        "surface-tint": "#3b6934",
                        "secondary-container": "#d9e6da",
                        "on-surface-variant": "#42493e",
                        "secondary-fixed-dim": "#bdcabe",
                        "on-secondary": "#ffffff",
                        "inverse-on-surface": "#f2f0f0",
                        "surface-container": "#efeded",
                        "surface-container-high": "#eae8e7",
                        "secondary-fixed": "#d9e6da",
                        "surface-dim": "#dbd9d9",
                        "on-primary-container": "#9dd090",
                        "on-secondary-container": "#5b675e",
                        "tertiary-fixed": "#e4e4cc",
                        "on-tertiary-fixed-variant": "#474836",
                        "on-primary-fixed-variant": "#23501e",
                        "on-tertiary": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface-container-highest": "#e4e2e2",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f5f3f3"
                    },
                    "borderRadius": {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "base": "8px",
                        "container-margin": "24px",
                        "unit-3": "1.5rem",
                        "unit-6": "3rem",
                        "unit-2": "1rem",
                        "unit-4": "2rem",
                        "unit-1": "0.5rem",
                        "gutter": "16px"
                    },
                    "fontFamily": {
                        "body-lg": ["Public Sans"],
                        "body-md": ["Public Sans"],
                        "label-sm": ["Public Sans"],
                        "headline-md": ["Quicksand"],
                        "display-lg": ["Quicksand"],
                        "display-lg-mobile": ["Quicksand"]
                    },
                    "fontSize": {
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "label-sm": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "display-lg": ["40px", { "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "40px", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
    <style>
        .neo-shadow {
            box-shadow: 12px 12px 24px rgba(209, 207, 206, 0.4), -12px -12px 24px rgba(255, 255, 255, 0.8);
        }

        .neo-inner-shadow {
            box-shadow: inset 8px 8px 16px rgba(209, 207, 206, 0.5), inset -8px -8px 16px rgba(255, 255, 255, 0.9);
        }

        .pulse-animation {
            animation: pulse-red 2s infinite;
        }

        @keyframes pulse-red {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(186, 26, 26, 0.4);
            }

            70% {
                transform: scale(1.02);
                box-shadow: 0 0 0 15px rgba(186, 26, 26, 0);
            }

            100% {
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(186, 26, 26, 0);
            }
        }
    </style>
    <style>
        body {
            min-height: max(884px, 100dvh);
        }
    </style>
</head>

<body class="bg-background text-on-background font-body-md min-h-screen flex flex-col">
    <!-- TopAppBar Shell (Suppressed Nav for Transactional Flow, but Header Present) -->
    <header
        class="bg-background w-full z-50 flex justify-between items-center px-container-margin py-unit-2 border-b border-surface-variant">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary font-headline-md text-headline-md"
                style="font-variation-settings: 'FILL' 1;">healing</span>
            <span class="font-headline-md text-headline-md font-bold text-primary tracking-tight">MediKiosk</span>
        </div>
        <button
            class="flex items-center justify-center p-2 rounded-full hover:bg-surface-variant transition-colors text-primary">
            <span class="material-symbols-outlined text-[28px]">help</span>
        </button>
    </header>
    <!-- Main Canvas -->
    <main
        class="flex-grow flex flex-col items-center px-container-margin py-unit-6 max-w-4xl mx-auto w-full gap-unit-6">
        <!-- Progress Indicator -->
        <section class="w-full max-w-2xl flex flex-col gap-2">
            <div class="flex justify-between items-center px-2">
                <span class="font-label-sm text-label-sm text-secondary">Step 3 of 5</span>
                <span class="font-label-sm text-label-sm text-primary font-bold">Clinical Questionnaire</span>
            </div>
            <div class="h-4 w-full bg-surface-container-high rounded-full neo-inner-shadow overflow-hidden">
                <div class="h-full bg-primary-container rounded-full w-3/5 transition-all duration-500 ease-out"></div>
            </div>
        </section>
        <!-- Red Flag Triage Banner (Dynamic State) -->
        <section
            class="w-full max-w-2xl hidden bg-error-container text-on-error-container rounded-lg p-unit-3 flex items-start gap-4 pulse-animation neo-shadow"
            id="triage-banner">
            <span class="material-symbols-outlined text-error text-display-lg-mobile"
                style="font-variation-settings: 'FILL' 1;">warning</span>
            <div>
                <h3 class="font-headline-md text-headline-md text-error mb-1">Critical Symptom Alert</h3>
                <p class="font-body-md text-body-md text-on-error-container">Based on your previous answers, please
                    notify staff immediately if you are experiencing severe chest pain or difficulty breathing right
                    now.</p>
            </div>
            <button class="ml-auto text-error hover:opacity-70 p-2"
                onclick="document.getElementById('triage-banner').classList.add('hidden')">
                <span class="material-symbols-outlined">close</span>
            </button>
        </section>
        <!-- Questionnaire Card -->
        <section class="w-full max-w-2xl bg-surface rounded-xl neo-shadow p-unit-6 flex flex-col gap-unit-4">
            <div class="text-center">
                <span class="font-label-sm text-label-sm text-outline uppercase tracking-widest mb-2 block">Question 3
                    of 8</span>
                <h2 class="font-display-lg-mobile text-display-lg-mobile text-on-surface mb-unit-4">Have you experienced
                    any sudden shortness of breath?</h2>
            </div>
            <!-- Primary Question Actions -->
            <div class="flex flex-col md:flex-row gap-unit-3 justify-center items-stretch w-full mb-unit-4">
                <button
                    class="flex-1 min-h-[80px] rounded-lg bg-surface text-on-surface font-headline-md text-headline-md neo-shadow active:neo-inner-shadow hover:bg-surface-variant transition-all flex items-center justify-center gap-3">
                    <span class="material-symbols-outlined text-primary text-[32px]"
                        style="font-variation-settings: 'FILL' 1;">check_circle</span>
                    Yes
                </button>
                <button
                    class="flex-1 min-h-[80px] rounded-lg bg-surface text-on-surface font-headline-md text-headline-md neo-shadow active:neo-inner-shadow hover:bg-surface-variant transition-all flex items-center justify-center gap-3">
                    <span class="material-symbols-outlined text-secondary text-[32px]">cancel</span>
                    No
                </button>
            </div>
            <!-- Voice Input Option -->
            <div class="flex justify-center">
                <button
                    class="flex items-center gap-2 px-6 py-3 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm hover:bg-tertiary-container hover:text-on-tertiary-container transition-colors neo-shadow">
                    <span class="material-symbols-outlined text-[20px]">mic</span>
                    Use Voice Input to Describe
                </button>
            </div>
            <div class="w-full h-px bg-surface-variant my-unit-2"></div>
            <!-- Secondary Question: Pain Scale -->
            <div class="flex flex-col gap-unit-3">
                <h3 class="font-headline-md text-headline-md text-on-surface text-center">Current Pain Scale (0-10)</h3>
                <div class="flex flex-wrap justify-between gap-2 px-unit-2">
                    <!-- Pill Buttons for Pain Scale -->
                    <script>
                        for (let i = 0; i <= 10; i++) {
                            let colorClass = i < 4 ? 'text-primary' : (i < 7 ? 'text-tertiary' : 'text-error');
                            let activeClass = i === 4 ? 'bg-primary-container text-on-primary-container neo-inner-shadow' : 'bg-surface text-on-surface neo-shadow hover:bg-surface-variant';
                            document.write(`
                                <button class="w-12 h-14 rounded-full flex items-center justify-center font-headline-md text-headline-md transition-all ${activeClass} ${colorClass}">
                                    ${i}
                                </button>
                            `);
                        }
                    </script>
                </div>
                <div class="flex justify-between px-unit-3 text-secondary font-label-sm text-label-sm">
                    <span>No Pain</span>
                    <span>Moderate</span>
                    <span>Severe</span>
                </div>
            </div>
        </section>
    </main>
    <!-- Bottom Navigation / Actions (Transactional Flow - Overridden to specific actions) -->
    <footer
        class="w-full px-container-margin py-unit-4 flex justify-between items-center gap-unit-3 bg-surface-container-low neo-shadow sticky bottom-0 rounded-t-lg z-40">
        <button
            class="min-h-[64px] px-unit-6 rounded-lg bg-surface text-primary font-headline-md text-headline-md neo-shadow active:neo-inner-shadow hover:bg-surface-variant transition-all flex items-center gap-2">
            <span class="material-symbols-outlined">arrow_back</span>
            Back
        </button>
        <button
            class="min-h-[64px] flex-1 max-w-sm rounded-lg bg-primary-container text-on-primary-container font-headline-md text-headline-md neo-shadow active:neo-inner-shadow hover:opacity-90 transition-all flex items-center justify-center gap-2">
            Next Step
            <span class="material-symbols-outlined">arrow_forward</span>
        </button>
    </footer>
    <script>
        // Simple mock logic to show triage banner for demonstration
        setTimeout(() => {
            const banner = document.getElementById('triage-banner');
            if (banner) {
                banner.classList.remove('hidden');
                // Auto hide after 5 seconds for preview purposes
                setTimeout(() => banner.classList.add('hidden'), 5000);
            }
        }, 2000);
    </script>
</body>

</html>